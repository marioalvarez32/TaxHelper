{
	"extends": "../tsconfig.json",
	"compilerOptions": {
		"composite": true,
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"outDir": "../out",
		"noEmit": false,
		"rootDir": ".."
	},
	"include": [
		"main/**/*",
		"preload/**/*",
		"../src/preload/index.ts",
		"../src/main/**/*",
		"../src/resources/**/*",
		"../src/**/*.ts"
	],
	"exclude": ["node_modules"]
}
