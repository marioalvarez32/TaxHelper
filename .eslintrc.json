{
  "env": {
    "es2021": true,
    "node": true
  },
  "extends": [
    "plugin:vue/vue3-essential",
    "standard-with-typescript",
    "eslint:recommended"
  ],
  "overrides": [],
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module",
    "project": [
      "tsconfig.json"
    ]
  },
  "plugins": [
    "vue"
  ],
  "rules": {
    "semi": "off",
    "@typescript-eslint/semi": "off",
    "space-before-function-paren": "off"
  }
}